---
const { title = 'Finding the Right Words', description = '', navItems } = Astro.props;
const base = import.meta.env.BASE_URL; // '/app/' in this preview build
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Public+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet" />
  <style is:global>
    :root{
      --paper:#F7F5F1; --card:#FFFFFF; --ink:#1E2A36; --navy:#0F2337;
      --ink-soft:#465360; --ink-faint:#7C8894; --line:#E4DFD7;
      --brass:#D8C58C; --brass-deep:#B7975A; --brand:#176C9B; --warm:rgba(151,143,131,.13);
      --serif:'Newsreader',Georgia,'Times New Roman',serif;
      --ui:'Public Sans','Segoe UI',Helvetica,Arial,sans-serif;
    }
    *{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--ui);line-height:1.6;font-size:17px;-webkit-font-smoothing:antialiased;display:flex;flex-direction:column;min-height:100vh}
    main{flex:1 0 auto}
    a{color:var(--brand);text-underline-offset:2px}

    .nav{background:rgba(15,35,55,.97);position:sticky;top:0;z-index:20}
    .nav-in{max-width:1040px;margin:0 auto;height:63px;display:flex;align-items:center;justify-content:space-between;padding:0 1.3rem;gap:1rem}
    .brand{font-family:var(--serif);font-size:1.28rem;letter-spacing:.01em;white-space:nowrap}
    .brand a{text-decoration:none}
    .brand .l{color:#CBB37A;font-weight:500}
    .brand .r{color:#E6CE8F;font-weight:600}
    .navlinks{display:flex;gap:1.4rem;font-size:.95rem;align-items:center}
    .navlinks a{color:#DCE2E8;text-decoration:none;font-weight:500;white-space:nowrap}
    .navlinks a:hover{color:#fff}
    .navlinks .enroll{background:#2C6A93;color:#fff;padding:.5rem 1.05rem;border-radius:7px}
    .navlinks .enroll:hover{background:#357aa7;color:#fff}
    @media(max-width:600px){ .navlinks{gap:.9rem;font-size:.85rem} .brand{font-size:1.02rem} .navlinks .hide-sm{display:none} }

    .site-footer{flex-shrink:0;text-align:center;padding:2.8rem 1.25rem 3.2rem;color:var(--ink-faint);font-size:.9rem;border-top:1px solid var(--line);margin-top:2rem}
    .site-footer a{color:var(--ink-faint)}
    .site-footer .fine{margin:.5rem 0 0;font-size:.82rem}
  </style>
</head>
<body>
  <div class="nav">
    <div class="nav-in">
      <div class="brand"><a href={base}><span class="l">Finding the </span><span class="r">Right Words</span></a></div>
      <nav class="navlinks">
        {navItems ? navItems.map((it) => (
          <a href={it.href} class:list={[{ enroll: it.cta, 'hide-sm': it.hideSm }]}>{it.label}</a>
        )) : (
          <Fragment>
            <a class="hide-sm" href="/">About the program</a>
            <a href="/receive-field-guide/">Field Guide</a>
            <a class="enroll" href="/enroll/">Enroll</a>
          </Fragment>
        )}
      </nav>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <p>Questions? Email <a href="mailto:support@edenmethod.com">support@edenmethod.com</a>.</p>
    <p class="fine">Finding the Right Words · David Feinstein, PhD</p>
  </footer>
</body>
</html>
