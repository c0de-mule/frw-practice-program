---
import Base from '../layouts/Base.astro';
import fgCss from '../fragments/fieldguide.css?raw';
import fgBody from '../fragments/fieldguide.body.html?raw';
import fgJs1 from '../fragments/fieldguide.js1.js?raw';
import fgJs2 from '../fragments/fieldguide.js2.js?raw';
---
<Base title="Field Guide — Finding the Right Words" description="A printable field guide for acupoint tapping practitioners.">
  <style is:global set:html={fgCss}></style>
  <div class="fg-body">
    <Fragment set:html={fgBody} />
  </div>

  <script is:inline>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
  <script is:inline set:html={fgJs1}></script>
  <script is:inline set:html={fgJs2}></script>
</Base>
